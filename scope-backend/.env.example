# ============================================================
# SCOPE Backend - Environment Variables Template
# ============================================================
# Copy this file to .env and fill in the actual values.
# NEVER commit the real .env file to version control.
# ============================================================

# --- Server ---
PORT=5000

# --- CORS ---
# URL of the frontend application allowed to make requests to this API
CLIENT_URL=http://localhost:3000

# --- Security ---
# Use a long, random string. You can generate one with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=your_super_secret_jwt_key_here

# --- Database (PostgreSQL) ---
# Used at runtime via connection pooling (e.g., PgBouncer / Supabase Pooler)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&connection_limit=1"

# Direct connection — used by Prisma Migrate (bypasses pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
